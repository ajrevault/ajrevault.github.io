{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/ajrevault/ajrevault.github.io/refs/heads/main/wk4_global_temp.csv",
    "format": {"type": "csv", "parse": {"date": "date", "temp_c": "number"}}
  },
  "transform": [
    {"calculate": "year(datum.date)", "as": "year"},
    {
      "calculate": "datum.year <= 2023 ? '1940–2023' : toString(datum.year)",
      "as": "group"
    },
    {"filter": "!(datum.year == 2026 && utcmonth(datum.date) > 7)"}
  ],
  "config": {"background": "#fff1e5", "view": {"stroke": null}},
  "title": {
    "text": "August 2026 was the warmest month globally on record",
    "font": "Source Sans 3",
    "fontWeight": 300,
    "fontSize": 20,
    "subtitle": "Average monthly global surface air temperature (degrees Celsius)",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": 300,
    "subtitlePadding": 20,
    "subtitleColor": "#5e5b58",
    "anchor": "start",
    "color": "#403d3b",
    "offset": 20
  },
"width": "400",
"height": "200",
  "layer": [
    {"mark": {"type": "line", "opacity": 1}},
    {
      "transform": [
        {
          "joinaggregate": [{"op": "max", "field": "date", "as": "last_date"}],
          "groupby": ["year"]
        },
        {
          "filter": "datum.year == 2026 && time(datum.date) === time(datum.last_date)"
        },
        {
          "calculate": "['The average temperature was', format(datum.temp_c, '.1f') + 'C' + ', overtaking July', ' 2023 for the hottest month']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -25,
        "fontSize": 13,
        "fontWeight": 450,
        "font": "Source Sans 3",
        "lineHeight": 18
      },
      "encoding": {
        "text": {"field": "label", "type": "nominal"},
        "color": {"values": "#403d3b"}
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "timeUnit": "month",
      "title": null,
      "axis": {
        "format": "%b",
        "grid": false,
        "domainColor": "#817c7a",
        "tickColor": "#817c7a",
        "labelColor": "#403d3b",
        "labelFont": "verdana",
        "labelFontWeight": 300,
        "labelFontSize": 12,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "temp_c",
      "type": "quantitative",
      "scale": {"domainMin": 10, "domainMax": 18},
      "title": null,
      "axis": {
        "domain": false,
        "gridColor": "#cfc6bd",
        "ticks": false,
        "labelColor": "#403d3b",
        "labelPadding": 8,
        "labelFont": "verdana",
        "labelFontWeight": 300,
        "labelFontSize": 12,
        "tickMinStep": 2
      }
    },
    "detail": {"field": "year", "type": "nominal"},
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": ["2026", "2025", "2024", "1940–2023"],
        "range": ["#B71C1C", "#ff8833", "#FDD835", "#D9CFCC"]
      },
      "legend": {
        "orient": "none",
        "legendX": -25,
        "legendY": -60,
        "direction": "horizontal",
        "title": null,
        "labelFont": "verdana",
        "labelFontWeight": 300,
        "labelColor": "#403d3b",
        "symbolType": "stroke",
        "symbolSize": 300,
        "symbolStrokeWidth": 9,
        "symbolStrokeColor": "#5e5b58",
        "labelFontSize": 12,
        "columnPadding": -12
      }
    },
    "strokeWidth": {
      "condition": {"test": "datum.year >= 2024", "value": 3},
      "value": 1.5
    }
  }
}